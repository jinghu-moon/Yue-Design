{
  "name": "snapclip-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SnapClip Design System monorepo: pure-CSS tokens, Vue 3 components, VitePress documentation",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm -C apps/docs dev",
    "preview": "corepack pnpm -C apps/docs preview",
    "build": "corepack pnpm -r build",
    "build:tokens": "corepack pnpm -C packages/tokens build",
    "build:hooks": "corepack pnpm -C packages/hooks build",
    "build:vue": "corepack pnpm -C packages/vue build",
    "build:docs": "corepack pnpm -C apps/docs build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:tokens": "node tools/audit-tokens.mjs",
    "verify:dist": "node tools/verify-dist.mjs",
    "verify": "corepack pnpm typecheck && corepack pnpm build && corepack pnpm test && corepack pnpm audit:tokens && corepack pnpm verify:dist",
    "clean": "corepack pnpm -r exec rimraf dist && rimraf apps/docs/.vitepress/dist apps/docs/.vitepress/cache"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "happy-dom": "14.12.3",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "4.0.18",
    "vue": "3.5.28",
    "vue-tsc": "2.2.12"
  }
}
