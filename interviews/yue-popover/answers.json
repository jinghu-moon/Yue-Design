  "userQuestions": [
    {
      "id": "user-question-1",
      "text": "Popover 应该复用共享定位逻辑，还是保持组件独立？请结合 ChengJing 与 Floating UI 研究后回答。",
      "kind": "design",
      "relatedQuestionId": 33,
      "status": "resolved",
      "round": 4,
      "resolution": "采用共享的无语义定位 hooks，使用 Floating UI 的 DOM 核心。"
    },
    {
      "id": "user-question-2",
      "text": "为什么不选择 @floating-ui/vue？@floating-ui/vue 与 @floating-ui/dom 有什么区别，后者更适合本项目吗？",
      "kind": "fact",
      "relatedQuestionId": 39,
      "status": "resolved",
      "round": 6,
      "resolution": "已记录在 finding-floating-ui-adapters，并由 Q40 决定 Yue 的依赖边界。"
    }
  ],
  "findings": [
    {
      "id": "finding-floating-ui-adapters",
      "topic": "@floating-ui/dom 与 @floating-ui/vue",
      "finding": "@floating-ui/dom 提供框架无关的定位核心；@floating-ui/vue 是 Vue 适配层。Yue 已有 hooks、Teleport、ARIA 与生命周期边界，因此只把 dom 核心作为内部依赖，不向消费者暴露 Floating UI 类型。",
      "sources": [
        "refer/floating-ui-master",
        "Popover spec research"
      ],
      "confidence": "high",
