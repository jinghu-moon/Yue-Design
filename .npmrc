# This machine cannot reach registry.npmjs.org directly; the mirror below is
# verified reachable and already warm in the pnpm store at D:\.pnpm-store\v10.
registry=https://mirrors.tencent.com/npm/

# Reuse the store whenever possible: every dependency version in this repo is
# pinned to a version that is already cached.
prefer-offline=true

auto-install-peers=true
strict-peer-dependencies=false
