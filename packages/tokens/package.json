{
  "name": "@yue-ui/design-tokens",
  "version": "0.1.0",
  "description": "Yue design tokens: pure CSS custom properties for light, dark, accent and forced-colors modes",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.css",
  "style": "./src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./index.css": "./src/index.css",
    "./implementations.css": "./src/implementations.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json",
    "./component-tokens/*.css": "./src/component-tokens/*.css"
  },
  "files": [
    "src",
    "assets",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node -e \"console.log('@yue-ui/design-tokens: pure CSS, no build step required')\"",
    "typecheck": "node -e \"console.log('@yue-ui/design-tokens: no TypeScript surface')\"",
    "audit": "node ../../tools/audit-tokens.mjs --target ."
  },
  "keywords": [
    "design-tokens",
    "css-custom-properties",
    "design-system",
    "theming"
  ]
}
